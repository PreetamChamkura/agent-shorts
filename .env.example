# Copy to .env and fill in. Never commit .env.
# Keep this file current whenever a new secret is introduced.

# LLM used by stage 3 (select). Not needed for milestone 1.
ANTHROPIC_API_KEY=

# TTS used by stage 3.5 (narrate). Not needed for milestone 1.
TTS_API_KEY=

# Optional: pin the exact ffmpeg/ffprobe binary run_ffmpeg uses, bypassing PATH.
# Needed on machines with more than one ffmpeg where the PATH-first build may
# lack the `ass`/`drawtext` filters. Leave unset to use whatever is on PATH.
# CLIPPER_FFMPEG_BIN=/opt/miniconda3/bin/ffmpeg
# CLIPPER_FFPROBE_BIN=/opt/miniconda3/bin/ffprobe
